# Database Configuration
# Copy this file to .env and update with your actual values
# Do not commit .env file to version control

# MySQL Configuration
MYSQL_URL=jdbc:mysql://localhost:3306/tender?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&zeroDateTimeBehavior=convertToNull&rewriteBatchedStatements=true&useServerPrepStmts=true&cachePrepStmts=true
MYSQL_USERNAME=root
MYSQL_PASSWORD=Q-SJ+#7sh
MYSQL_MAX_POOL_SIZE=20
MYSQL_MIN_IDLE=5
MYSQL_CONNECTION_TIMEOUT=30000
MYSQL_IDLE_TIMEOUT=600000
MYSQL_MAX_LIFETIME=1800000
MYSQL_LEAK_DETECTION_THRESHOLD=60000

# PostgreSQL Configuration
POSTGRES_URL=jdbc:postgresql://localhost:5432/tender1?reWriteBatchedInserts=true
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_MAX_POOL_SIZE=20
POSTGRES_MIN_IDLE=5
POSTGRES_CONNECTION_TIMEOUT=30000
POSTGRES_IDLE_TIMEOUT=600000
POSTGRES_MAX_LIFETIME=1800000
# Migration step control (optional)
# MIGRATION_MODE=chain|from|single
# MIGRATION_FROM_STEP=privilege-migration
# MIGRATION_ONLY_STEP=attendance-transaction-migration
# MIGRATION_VERIFY_AFTER_EACH=true
# MIGRATION_FAIL_ON_VERIFY=false
# MIGRATION_CHAIN_ENABLED=true
# attLogs + attendanceTransaction only (inclusive lower bound; upper = now). Other tables = all.
# ATTENDANCE_MIGRATE_FROM=2026-08-01
